{
  "manifest_version": 3,
  "name": "划词搜索 (H)",
  "version": "1.2.1",
  "description": "选中文字后按 H 呼出划词搜索面板，再按 G 用 Google 搜索、按 B 用百度搜索；右键菜单同样可用。",
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
