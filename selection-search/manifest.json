{
  "manifest_version": 3,
  "name": "划词搜索 (G/B)",
  "version": "1.3.0",
  "description": "选中文字后按 G 用 Google 搜索、按 B 用百度搜索。",
  "permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
